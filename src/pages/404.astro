---
import Base from '../components/Base.astro';
const title = 'Page not found | MH Electrical';
const description = 'That page is not on the MH Electrical site. Go back to the home page or call 07903 862367.';
---
<Base title={title} description={description}>
  <section class="page-hero">
    <div class="wrap">
      <p class="eyebrow">404</p>
      <h1>Page not found</h1>
      <p class="lede">That address is not on this site. The work is still the same: lights, fuse boards, faults, rewires and tests around Bedford.</p>
      <p><a class="btn" href="/">Back to the home page</a></p>
    </div>
  </section>
</Base>
